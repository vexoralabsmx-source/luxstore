# Next.js App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Credentials (Obtener de Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Clip Checkout Redireccionado (token generado en el panel de desarrolladores)
CLIP_AUTH_TOKEN=your-clip-checkout-auth-token

# Resend Email Service
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Lux Store <ventas@tu-dominio-verificado.com>
ADMIN_NOTIFICATION_EMAIL=admin@tu-dominio.com

# Cloudflare Turnstile Protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000AA

# Encryption key for digital stock inventory secrets (32 bytes hex)
INVENTORY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
